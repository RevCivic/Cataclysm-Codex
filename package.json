{
  "name": "cataclysm-codex",
  "version": "1.0.0",
  "description": "A campaign codex for a Starfinder (1st edition) campaign",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "sources:list": "node src/ingestion/cli.js list",
    "sources:fetch": "node src/ingestion/cli.js fetch",
    "sources:inspect": "node src/ingestion/cli.js inspect",
    "portainer:check-ref": "node scripts/check-portainer-git-ref.js",
    "test": "node --test src/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "lowdb": "^1.0.0",
    "mammoth": "^1.12.2",
    "read-excel-file": "^6.0.3",
    "undici": "^6.28.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
